# ==============================================================================
# Enterprise Intelligence Automation Platform (EIAP) - Environment Template
# ==============================================================================
# SECURITY NOTICE: Never commit actual secret values to version control.
# Copy this file to .env and configure local secure values.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Enterprise-Intelligence-Automation-API
APP_VERSION=1.0.0

# API Security
# Minimum 32-character high-entropy secret key for API authentication
API_KEY=dev_insecure_local_api_key_replace_for_real_work_32chars
WEBHOOK_SECRET=dev_webhook_signing_secret_replace_in_prod_32chars
CORS_ORIGINS=["http://localhost:5678","http://127.0.0.1:5678"]

# Database Configuration (PostgreSQL 16)
# Localhost-only container exposure
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_USER=eiap_admin
POSTGRES_PASSWORD=dev_insecure_pg_password_change_me
POSTGRES_DB_ANALYTICS=business_analytics
POSTGRES_DB_N8N=n8n_internal

# SQLAlchemy Database URL (Internal Docker network hostname)
DATABASE_URL=postgresql+psycopg://eiap_admin:dev_insecure_pg_password_change_me@postgres:5432/business_analytics
# Host-accessible URL for local migration/testing outside Docker
LOCAL_DATABASE_URL=postgresql+psycopg://eiap_admin:dev_insecure_pg_password_change_me@127.0.0.1:5433/business_analytics

# n8n Orchestrator Configuration
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=dev_n8n_encryption_key_change_me_must_be_32_chars
N8N_METRICS=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Mailpit (Local SMTP capture - Zero Cost / No Leaks)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eiap-reports@internal.local
MAILPIT_WEB_PORT=8025

# Optional Integrations (Disabled by default - Mock Mode active)
FEATURE_FLAG_POWERBI_ENABLED=false
FEATURE_FLAG_AI_SUMMARY_ENABLED=false
AI_PROVIDER=mock
POWERBI_ADAPTER=mock

