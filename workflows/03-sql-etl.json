          }
        ]
      ]
    },
    "Extract ETL Parameters": {
      "main": [
        [
          {
            "node": "Commit Transactional ETL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Commit Transactional ETL": {
      "main": [
        [
          {
            "node": "Format Pipeline Summary",
